# Eufy account (used by eufy-security-server)
# Note: actual credentials go in eufy-security-server's config.json,
# not here.

# Device serial numbers — find in Eufy app under Device Info
EUFY_SERIAL=T8423XXXXXXXXXXXX
EUFY_DOORBELL_SERIAL=T8200XXXXXXXXXXXX

# Local stream URLs the bridges output to and the nodes read from
CAMERA_URL=udp://127.0.0.1:5000?fifo_size=5000000&overrun_nonfatal=1
DOORBELL_URL=udp://127.0.0.1:5001?fifo_size=5000000&overrun_nonfatal=1

# Path to ffmpeg.exe (Windows; leave unset on Linux/Mac if on PATH)
FFMPEG_BIN=C:\path\to\ffmpeg.exe

# OpenAI API key for [D] scene description
OPENAI_API_KEY=sk-...